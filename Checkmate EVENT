local buttonBase = { [buttonWhite] = buttonWhite.CFrame, [buttonBlack] = buttonBlack.CFrame }

local function formatTime(t)
	t = math.max(0, t)
	return string.format("%d:%02d", math.floor(t / 60), math.floor(t % 60))
end

local function paintClock(force)
	local key = math.floor(timeWhite) .. "|" .. math.floor(timeBlack)
	if not force and key == lastPainted then return end
	lastPainted = key
	dialWhite.Text = formatTime(timeWhite)
	dialBlack.Text = formatTime(timeBlack)
end


local function pressSide(side)
	local down = side == "white" and buttonWhite or buttonBlack
	local up = side == "white" and buttonBlack or buttonWhite
	TweenService:Create(down, TweenInfo.new(0.10), { CFrame = CFrame.new(0, -0.14, 0) * buttonBase[down] }):Play()
	TweenService:Create(up, TweenInfo.new(0.10), { CFrame = buttonBase[up] }):Play()
end

local function startClock()
	if clockConn then return end
	local last = os.clock()
	clockConn = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		local dt = now - last
		last = now
		if blackTarget then
			timeBlack += (blackTarget - timeBlack) * math.min(dt * 6, 1)
			if math.abs(timeBlack - blackTarget) < 0.4 then timeBlack = blackTarget end
		elseif sideRunning == "black" then
			timeBlack = math.max(0, timeBlack - dt)
		end
		if sideRunning == "white" then
			timeWhite = math.max(0, timeWhite - dt)
		end
		paintClock()
	end)
end

local function stopClock()
	if clockConn then clockConn:Disconnect(); clockConn = nil end
end


local function startLampSwing()
	if lampConn then return end
	local base = lamp:GetPivot()
	local pivotPoint = lamp.WorldPivot.Position
	local angle = 0
	lampVelocity = 0
	lampConn = RunService.Heartbeat:Connect(function(dt)
		lampVelocity += (-26 * angle - 1.7 * lampVelocity) * dt
		angle += lampVelocity * dt
		lamp:PivotTo(CFrame.new(pivotPoint) * CFrame.Angles(angle * 0.35, 0, angle) * CFrame.new(-pivotPoint) * base)
	end)
end

local function stopLampSwing()
	if lampConn then lampConn:Disconnect(); lampConn = nil end
end

local function startBreathing()
	if breathConn or not raggy then return end
	local base = raggy:GetPivot()
	local t = 0
	breathConn = RunService.Heartbeat:Connect(function(dt)
		t += dt
		local rise = math.sin(t * 1.5) * 0.045
		raggy:PivotTo(base * CFrame.new(0, rise, 0) * CFrame.Angles(math.sin(t * 1.5) * 0.006, 0, 0))
	end)
end

local function stopBreathing()
	if breathConn then breathConn:Disconnect(); breathConn = nil end
end


local function remember(part)
	snapshot[part] = part.CFrame
	baseRot[part] = part.CFrame - part.CFrame.Position
end

local function takeSnapshot()
	for _, folder in ipairs({ whiteFolder, blackFolder }) do
		for _, piece in ipairs(folder:GetChildren()) do
			if piece:IsA("BasePart") then
				piece.Anchored = true
				remember(piece)
			end
		end
	end
	for _, model in ipairs({ clock, chairBlack, lamp, props }) do
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then remember(d) end
		end
	end
end

local function restore()
	stopLampSwing()
	stopBreathing()
	for _, inst in ipairs(scratch) do
		if inst.Parent then inst:Destroy() end
	end
	table.clear(scratch)
	for part, cf in pairs(snapshot) do
		if part.Parent then
			part.Anchored = true
			part.CFrame = cf
		end
	end
	lamp.WorldPivot = lampPivot0
	if raggy and raggyPivot0 then raggy:PivotTo(raggyPivot0) end
	timeWhite, timeBlack, blackTarget, sideRunning = WHITE_TIME, BLACK_TIME, nil, nil
	paintClock(true)
end

