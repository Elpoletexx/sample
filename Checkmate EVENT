	if kicker then show(kickerLabel, 0, 0.08, 0.45) end
	for i, line in ipairs({ ruleTop, ruleBottom }) do
		line.Size = UDim2.new(0, 0, 0, 1)
		line.BackgroundTransparency = 0.28
		TweenService:Create(line, TweenInfo.new(0.75, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, 0, false, 0.05 * i), {
			Size = UDim2.new(0.13, 0, 0, 1),
		}):Play()
	end
	task.delay(2.5, function()
		if token ~= titleToken then return end
		hide(titleLabel, 0.45)
		hide(kickerLabel, 0.45)
		hide(ruleTop, 0.45)
		hide(ruleBottom, 0.45)
	end)
end

local function showRule(article, body)
	ruleArticle.Text = article
	ruleBody.Text = body
	show(ruleCard, 0.14, 0, 0.45)
	show(ruleEdge, 0, 0.02, 0.45)
	show(ruleHeading, 0, 0.06, 0.45)
	show(ruleArticle, 0, 0.12, 0.45)
	show(ruleBody, 0, 0.18, 0.5)
end

local function hideRule()
	for _, obj in ipairs({ ruleCard, ruleEdge, ruleHeading, ruleArticle, ruleBody }) do hide(obj, 0.35) end
end

local function showCaption(text)
	if text == nil or text == "" then
		hide(captionLabel, 0.35)
		return
	end
	captionLabel.Text = text
	show(captionLabel, 0, 0.05, 0.45)
end

local function shot(name, override)
	local s = SHOT[name]
	if not s then return end
	TweenService:Create(camGoal, TweenInfo.new(override or s[3], Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Value = CFrame.lookAt(s[1], s[2]),
	}):Play()
end

local function shake(amount)
	shakeAmount = math.max(shakeAmount, amount)
end

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid") or nil
end

local function setCharacterVisible(visible)
	local char = player.Character
	if not char then return end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.LocalTransparencyModifier = visible and 0 or 1
		end
	end
end

local function enterCinematic()
	if active then return end
	active = true

	local hum = getHumanoid()
	savedWorld = {
		cameraType = camera.CameraType,
		cameraSubject = camera.CameraSubject,
		clockTime = Lighting.ClockTime,
		walkSpeed = hum and hum.WalkSpeed or 16,
		jumpPower = hum and hum.JumpPower or 50,
		autoRotate = hum ~= nil and hum.AutoRotate or true,
	}
	if hum then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.AutoRotate = false
	end
	pcall(function() StarterGui:SetCore("TopbarEnabled", false) end)

	colourEffect = Instance.new("ColorCorrectionEffect")
	colourEffect.Parent = Lighting
	TweenService:Create(colourEffect, TweenInfo.new(1.2), { Contrast = 0.16, Saturation = -0.1, Brightness = -0.03 }):Play()

	camGoal.Value = camera.CFrame
	camera.CameraType = Enum.CameraType.Scriptable
	gui.Enabled = true
	setCharacterVisible(false)

	TweenService:Create(barTop, TweenInfo.new(0.7, Enum.EasingStyle.Quint), { Size = UDim2.fromScale(1, 0.098) }):Play()
	TweenService:Create(barBottom, TweenInfo.new(0.7, Enum.EasingStyle.Quint), { Size = UDim2.fromScale(1, 0.098) }):Play()

	RunService:BindToRenderStep(RENDER_KEY, Enum.RenderPriority.Camera.Value + 1, function(dt)
		shakeAmount = math.max(0, shakeAmount - dt * 2.6)
		local offset = Vector3.new(
			(math.random() - 0.5) * shakeAmount,
			(math.random() - 0.5) * shakeAmount,
			(math.random() - 0.5) * shakeAmount * 0.4
		)
		camera.CFrame = camGoal.Value * CFrame.new(offset)
		if timelapseSpeed > 0 then
			Lighting.ClockTime = (Lighting.ClockTime + dt * timelapseSpeed) % 24
		end
		setCharacterVisible(false)
	end)
end

local function exitCinematic()
	if not active then return end
	active = false
	timelapseSpeed, shakeAmount = 0, 0
	titleToken += 1
	pcall(function() RunService:UnbindFromRenderStep(RENDER_KEY) end)

	TweenService:Create(barTop, TweenInfo.new(0.5, Enum.EasingStyle.Quint), { Size = UDim2.fromScale(1, 0) }):Play()
	TweenService:Create(barBottom, TweenInfo.new(0.5, Enum.EasingStyle.Quint), { Size = UDim2.fromScale(1, 0) }):Play()
	for _, obj in ipairs({ titleLabel, kickerLabel, captionLabel, ruleTop, ruleBottom, winKicker, winTitle, winSub, winFoot, winChip, winRule }) do
		hide(obj, 0.4)
	end
	hideRule()
	TweenService:Create(winCard, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(winStroke, TweenInfo.new(0.4), { Transparency = 1 }):Play()

	if colourEffect then
		local effect = colourEffect
		colourEffect = nil
		TweenService:Create(effect, TweenInfo.new(0.6), { Contrast = 0, Saturation = 0, Brightness = 0 }):Play()
		task.delay(0.8, function() effect:Destroy() end)
	end

	if savedWorld then
		Lighting.ClockTime = savedWorld.clockTime
		local hum = getHumanoid()
		if hum then
			hum.WalkSpeed = savedWorld.walkSpeed
			hum.JumpPower = savedWorld.jumpPower
			hum.AutoRotate = savedWorld.autoRotate
		end
		camera.CameraType = savedWorld.cameraType
		camera.CameraSubject = savedWorld.cameraSubject
		savedWorld = nil
	else
		camera.CameraType = Enum.CameraType.Custom
	end
	pcall(function() StarterGui:SetCore("TopbarEnabled", true) end)

	setCharacterVisible(true)
	task.delay(0.6, function()
		if not active then
			gui.Enabled = false
			winCard.Visible = false
		end
	end)
end

local function sequence()
	local h1x, h1z = squareXZ("H1")
	local tableY = TABLE_TOP + KING_HALF

	enterCinematic()
	shot("open")
	task.wait(0.05)
	shot("mate")

	
	sideRunning = "white"
	startClock()
	startBreathing()
	checkLine()
	glow(blackQueen, Color3.fromRGB(214, 66, 58), Color3.fromRGB(238, 122, 112), 0.78)
	local kingGlow = glow(whiteKing, Color3.fromRGB(214, 66, 58), Color3.fromRGB(240, 172, 162), 0.82)
	playSound(SOUND.Ping, board, 0.9)
	showTitle("CHECKMATE", "WHITE TO MOVE")
	showCaption("white has no legal move")
	task.wait(2.3)

	
	local upright = whiteKing.CFrame
	showTitle("...no.")
	shake(0.10)
	for i = 1, 3 do
		local side = (i % 2 == 0) and 1 or -1
		TweenService:Create(whiteKing, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
			CFrame = tilted(upright, KING_HALF, Vector3.zAxis, math.rad(17) * side),
		}):Play()
		task.wait(0.17)
	end
	TweenService:Create(whiteKing, TweenInfo.new(0.18), { CFrame = upright }):Play()
	task.wait(0.55)

	
	shot("walk")
	showCaption("the white king steps off h1")
	kingGlow.FillColor, kingGlow.OutlineColor = ACCENT, ACCENT
	walk(whiteKing, {
		Vector3.new(65.0, tableY, -0.65),
		Vector3.new(65.5, tableY, -2.05),
	}, 0.60, 0.85)

	
	shot("reveal")
	task.wait(1.0)
	showTitle("BLACK.", "THE OPPONENT")
	showCaption("asleep for forty minutes")
	playSound(SOUND.Snore, raggy and raggy:FindFirstChildWhichIsA("BasePart", true) or board, 1, 0.32)
	task.wait(1.6)
	playSound(SOUND.Snore, board, 0.7, 0.28)
	task.wait(0.6)


	shot("climb")
	showCaption("")
	hop(whiteKing, Vector3.new(65.9, CLOCK_TOP + KING_HALF, -4.05), 0.70, 2.10)
	playSound(SOUND.Step, clockBody, 0.8, 0.9)
	task.wait(0.45)

	
	shot("press")
	hop(whiteKing, Vector3.new(65.9, CLOCK_TOP + 0.34 + KING_HALF, -2.95), 0.42, 0.75)
	pressSide("white")
	playSound(SOUND.Press, clockBody, 1)
	sideRunning = "black"
	shake(0.16)
	showRule("ARTICLE 7.5.5", "Pressing the clock without having made a move shall be considered and penalised as an illegal move.")
	task.wait(1.7)

	
	shot("sleep")
	showRule("ARTICLE 4.8", "An illegal move must be claimed by the opponent.")
	playSound(SOUND.Snore, board, 0.9, 0.3)
	task.wait(1.9)

	shot("stomp")
	hideRule()
	showCaption("nobody is claiming anything")
	playSound(SOUND.Wind, clockBody, 0.5, 1.3)
	startLampSwing()
	timelapseSpeed = 26
	local stomps = 5
	for i = 1, stomps do
		hop(whiteKing, Vector3.new(65.9, CLOCK_TOP + KING_HALF, -4.05 + ((i % 2 == 0) and 0.30 or -0.30)), 0.30, 1.15)
		playSound(SOUND.Stomp, clockBody, 1, 0.85 + i * 0.06)
		blackTarget = BLACK_TIME * (1 - i / stomps) ^ 1.5
		lampVelocity += 1.9
		shake(0.22 + i * 0.08)
		timelapseSpeed = 26 + i * 34
		puff(clockBody.Position + Vector3.new(0, 1.2, 0), 0.9, 3)
		for _, piece in ipairs(blackFolder:GetChildren()) do
			if piece:IsA("BasePart") and math.random() < 0.3 then puff(piece.Position, 0.5, 1) end
		end

	
		if i == 2 then
			local seat = chairBlack.Seat.Position
			task.spawn(tipModel, chairBlack, Vector3.new(seat.X, 0, seat.Z - 1.3), Vector3.xAxis, math.rad(-96), 0.55)
			task.delay(0.45, function() playSound(SOUND.Impact, chairBlack.Seat, 1, 0.8) end)
		elseif i == 3 then
			task.spawn(function()
				local base = mug.Position
				topple(mug, Vector3.new(-1, 0, 0.6), 0.4)
				playSound(SOUND.Knock, mug, 0.8, 1.2)
				puff(base, 0.6, 2)
			end)
		end
		task.wait(0.16)
	end
	blackTarget = 0
	task.wait(0.7)
	stopLampSwing()
	timelapseSpeed = 0

	shot("flag")
	showTitle("FLAG FALL")
	showRule("ARTICLE 6.9", "A player who runs out of time loses the game.")
	shake(0.75)
	playSound(SOUND.Snap, clockBody, 1)
	playSound(SOUND.Boom, board, 1, 0.65)
	if colourEffect then
		TweenService:Create(colourEffect, TweenInfo.new(0.1), { Brightness = 0.32, Contrast = 0.45 }):Play()
		task.delay(0.18, function()
			if colourEffect then
				TweenService:Create(colourEffect, TweenInfo.new(0.7), { Brightness = -0.03, Contrast = 0.16 }):Play()
			end
		end)
	end
	task.spawn(fling, clockFlag, Vector3.new(66.9, TABLE_TOP + 0.14, -6.0), 0.55, Vector3.zAxis)
	task.wait(1.5)


	shot("collapse")
	hideRule()
	shake(0.5)
	shockwave(Vector3.new(60, BOARD_TOP + 0.08, -4), 30, 0.85)
	playSound(SOUND.Knock, board, 1, 0.8)
	task.spawn(topple, blackKing, Vector3.new(0, 0, 1), 0.55)
	puff(blackKing.Position, 1.2, 5)
	glow(blackKing, Color3.fromRGB(30, 30, 30), Color3.fromRGB(214, 66, 58), 0.85)

	local order = {}
	for _, piece in ipairs(blackFolder:GetChildren()) do
		if piece:IsA("BasePart") and piece ~= blackKing and piece ~= blackQueen then
			table.insert(order, piece)
		end
	end
	table.sort(order, function(a, b)
		return (a.Position - blackKing.Position).Magnitude < (b.Position - blackKing.Position).Magnitude
	end)
	for i, piece in ipairs(order) do
		task.delay(0.055 * i, function()
			if state ~= RUNNING then return end
			local away = (piece.Position - blackKing.Position) * Vector3.new(1, 0, 1)
			topple(piece, away.Magnitude > 0.1 and away or Vector3.xAxis, 0.42)
			playSound(SOUND.Knock, piece, 0.3, 1.2 + math.random() * 0.3)
		end)
	end

	task.delay(0.2, function()
		if state ~= RUNNING then return end
		fling(blackQueen, Vector3.new(69.8, FLOOR_TOP + 0.34, -9.0), 0.9, Vector3.zAxis)
		playSound(SOUND.Impact, board, 0.6, 1.1)
	end)
	task.wait(2.2)


	shot("crown")
	showCaption("the king walks back to h1")
	sideRunning = nil
	walk(whiteKing, {
		Vector3.new(65.4, tableY, -2.30),
		Vector3.new(h1x, BOARD_TOP + KING_HALF, h1z),
	}, 0.55, 1.30)

	shot("final")
	showCaption("")
	glow(whiteKing, ACCENT, ACCENT, 0.72)
	shockwave(whiteKing.Position, 22, 1.1)
	confetti(90)
	playSound(SOUND.Victory, board, 1)
	winCard.Visible = true
	TweenService:Create(winCard, TweenInfo.new(0.6), { BackgroundTransparency = 0.32 }):Play()
	TweenService:Create(winStroke, TweenInfo.new(0.9), { Transparency = 0.45 }):Play()
	show(winKicker, 0, 0.15, 0.5)
	show(winTitle, 0, 0.28, 0.6)
	winRule.Size = UDim2.new(0, 0, 0, 1)
	winRule.BackgroundTransparency = 0.22
	TweenService:Create(winRule, TweenInfo.new(0.9, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, 0, false, 0.45), {
		Size = UDim2.new(0.19, 0, 0, 1),
	}):Play()
	show(winSub, 0, 0.6, 0.5)
	show(winFoot, 0, 0.85, 0.6)
	show(winChip, 0, 1.15, 0.6)
	task.wait(7.5)
end

