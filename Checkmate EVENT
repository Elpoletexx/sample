local function propOf(obj)
	return obj:IsA("TextLabel") and "TextTransparency" or "BackgroundTransparency"
end

local function show(obj, visible, delay, duration)
	local home = obj:GetAttribute("Home") or obj.Position
	obj:SetAttribute("Home", home)
	obj.Position = home + UDim2.fromOffset(0, RISE)
	obj[propOf(obj)] = 1
	TweenService:Create(obj, TweenInfo.new(duration or 0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, 0, false, delay or 0), {
		[propOf(obj)] = visible, Position = home,
	}):Play()
end

local function hide(obj, duration)
	TweenService:Create(obj, TweenInfo.new(duration or 0.3), { [propOf(obj)] = 1 }):Play()
end

