local function animate(duration, fn)
	local t0 = os.clock()
	local a = 0
	while a < 1 do
		a = math.clamp((os.clock() - t0) / duration, 0, 1)
		fn(a)
		RunService.Heartbeat:Wait()
	end
end

local function tilted(cf, halfHeight, axis, angle)
	local pivot = cf.Position - Vector3.yAxis * halfHeight
	return CFrame.new(pivot) * CFrame.fromAxisAngle(axis, angle) * CFrame.new(-pivot) * cf
end

local function squareXZ(name)
	local attachment = board:FindFirstChild(name)
	if not attachment then return 0, 0 end
	return attachment.WorldPosition.X, attachment.WorldPosition.Z
end

local function hop(piece, target, duration, height)
	local rot = baseRot[piece]
	local half = piece.Size.X / 2
	local from = piece.Position
	local flat = (target - from) * Vector3.new(1, 0, 1)
	local axis = flat.Magnitude > 0.05 and Vector3.yAxis:Cross(flat.Unit) or Vector3.xAxis
	animate(duration, function(a)
		local pos = from:Lerp(target, a) + Vector3.yAxis * (math.sin(a * math.pi) * height)
		piece.CFrame = tilted(CFrame.new(pos) * rot, half, axis, math.sin(a * math.pi * 2) * math.rad(16))
	end)
	piece.CFrame = CFrame.new(target) * rot
end

local function walk(piece, points, stepDuration, height)
	for _, target in ipairs(points) do
		hop(piece, target, stepDuration, height)
		playSound(SOUND.Step, piece, 0.5, 1.5)
	end
end

local function topple(piece, direction, duration)
	local base = piece.CFrame
	local half = piece.Size.X / 2
	local flat = direction * Vector3.new(1, 0, 1)
	if flat.Magnitude < 0.01 then flat = Vector3.xAxis end
	local axis = Vector3.yAxis:Cross(flat.Unit)
	animate(duration, function(a)
		local eased = math.min(1, a * a * 1.06) - 0.06 * math.sin(a * math.pi) * (1 - a)
		piece.CFrame = tilted(base, half, axis, math.rad(92) * eased)
	end)
end

local function fling(piece, target, duration, spinAxis)
	local from = piece.Position
	local rot = piece.CFrame - from
	local peak = math.max(from.Y, target.Y) + 2.2
	animate(duration, function(a)
		local inv = 1 - a
		local y = inv * inv * from.Y + 2 * inv * a * peak + a * a * target.Y
		local pos = Vector3.new(from.X + (target.X - from.X) * a, y, from.Z + (target.Z - from.Z) * a)
		piece.CFrame = CFrame.new(pos) * CFrame.fromAxisAngle(spinAxis, a * math.pi * 3) * rot
	end)
end

local function tipModel(model, pivotPoint, axis, angle, duration)
	local base = model:GetPivot()
	animate(duration, function(a)
		local eased = 1 - (1 - a) ^ 3
		model:PivotTo(CFrame.new(pivotPoint) * CFrame.fromAxisAngle(axis, angle * eased) * CFrame.new(-pivotPoint) * base)
	end)
end
